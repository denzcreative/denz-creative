  ink:      { name: 'Tinta',      bg: '#0b0d12', ac: '#e8a24a' },
  midnight: { name: 'Malam biru', bg: '#0f1522', ac: '#8fb4ff' },
  charcoal: { name: 'Arang',      bg: '#171615', ac: '#d8b36a' },
  teal:     { name: 'Teal gelap', bg: '#0e1918', ac: '#5fd1c4' }
};
const CONTACTS = [
  ['email', 'Email', 'nama@email.com', v => v ? 'mailto:' + v : ''],
  ['whatsapp', 'WhatsApp', '08xxxxxxxxxx', waHref],
  ['instagram', 'Instagram', '@username', v => linkOrHandle(v, 'https://instagram.com/')],
  ['youtube', 'Kanal YouTube', '@namakanal', v => linkOrHandle(v, 'https://youtube.com/@')]
];

/* ---------- Helper ---------- */
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const get = path => path.split('.').reduce((o, k) => (o == null ? o : o[k]), state);
function setPath(path, val) {
  const ks = path.split('.'); const last = ks.pop();
  ks.reduce((o, k) => o[k], state)[last] = val;
}
function ytId(u) {
  if (!u) return null;
  const m = String(u).trim().match(/(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:watch\?(?:[^#]*&)?v=|shorts\/|embed\/|live\/|v\/))([\w-]{11})/);
  return m ? m[1] : null;
}
const isShortUrl = u => /\/shorts\//.test(u || '');
const initials = n => (String(n || '').trim().split(/\s+/).slice(0, 2).map(w => w[0]).join('') || 'P').toUpperCase();
function waHref(v) {
  let d = String(v || '').replace(/\D/g, '');
  if (!d) return '';
  if (d.startsWith('0')) d = '62' + d.slice(1);
  return 'https://wa.me/' + d;
}
function linkOrHandle(v, base) {
  v = String(v || '').trim();
  if (!v) return '';
  if (/^https:\/\//i.test(v)) return v;
  return base + v.replace(/^@/, '');
}
const ext = href => /^https?:/.test(href) ? ' target="_blank" rel="noopener noreferrer"' : '';

function ed(path, ph, multi) {
  if (!editing) return '';
  return ` contenteditable="true" spellcheck="false" role="textbox" aria-label="${esc(ph)}" data-path="${path}" data-ph="${esc(ph)}"${multi ? ' data-multi="1"' : ''}`;
}
function fld(tag, cls, path, ph, multi) {
  const v = get(path);
  if (!editing && !v) return '';
  return `<${tag}${cls ? ` class="${cls}"` : ''}${ed(path, ph, multi)}>${esc(v)}</${tag}>`;
}

/* ---------- Tampilan ---------- */
function workCard(w) {
  const wide = w.format === 'wide';
  const bad = w.url && !w.id;
  const thumb = w.id
    ? `<button class="thumb" type="button" data-act="play" data-i="${w.i}" aria-label="Putar ${esc(w.title)}"><img src="https://i.ytimg.com/vi/${w.id}/hqdefault.jpg" alt="" loading="lazy"><span class="play"><i></i></span></button>`
    : `<div class="thumb empty"><span>Tempel link YouTube di bawah</span></div>`;
  const tools = editing ? `
    <div class="wtools">
      <button class="mini" type="button" data-act="mv" data-i="${w.i}" data-d="-1" aria-label="Geser ke depan">Maju</button>
      <button class="mini" type="button" data-act="mv" data-i="${w.i}" data-d="1" aria-label="Geser ke belakang">Mundur</button>
      <button class="mini" type="button" data-act="fmt" data-i="${w.i}">${wide ? 'Horizontal' : 'Vertikal'}</button>
      <button class="mini danger" type="button" data-act="del" data-i="${w.i}">Hapus</button>
    </div>
    <input class="linkin${bad ? ' bad' : ''}" data-act="url" data-i="${w.i}" value="${esc(w.url)}" placeholder="Tempel link YouTube" aria-label="Link YouTube">
    ${bad ? '<span class="err">Link YouTube tidak dikenali.</span>' : ''}` : '';
  return `<article class="work${wide ? ' wide' : ''}">${thumb}
    ${fld('h3', '', `works.${w.i}.title`, 'Judul karya')}
    ${fld('span', 'tag', `works.${w.i}.tag`, 'Kategori')}${tools}</article>`;
}

function view() {
  const s = state;
  const works = s.works.map((w, i) => ({ ...w, i, id: ytId(w.url) }));
  const usable = works.filter(w => editing || w.id);
  const tags = ['Semua', ...new Set(usable.map(w => w.tag).filter(Boolean))];
  if (!tags.includes(filter)) filter = 'Semua';
  const shown = editing || filter === 'Semua' ? usable : usable.filter(w => w.tag === filter);
  const hasContact = Object.values(s.contact).some(Boolean);
  const primary = waHref(s.contact.whatsapp) || (s.contact.email ? 'mailto:' + s.contact.email : '');
  const hasAbout = editing || s.about;
  const hasWorks = editing || usable.length > 0;
  const hasExp = editing || s.experience.length > 0;
  const hasContactCard = editing || hasContact;
  const hasSkills = editing || s.skills.length > 0;

  const nav = [hasAbout && ['tentang', 'Tentang'], hasWorks && ['karya', 'Karya'], hasExp && ['pengalaman', 'Pengalaman'], hasContactCard && ['kontak', 'Kontak']]
    .filter(Boolean).map(([id, t]) => `<a href="#${id}">${t}</a>`).join('');

  const topbar = `<header class="topbar"><div class="topbar-in">
    <a class="mark" href="#top" aria-label="Ke atas">${esc(initials(s.name))}</a>
    <nav class="nav" aria-label="Bagian halaman">${nav}</nav><span class="spacer"></span>
    ${s.published ? '' : `<button class="btn quiet" type="button" data-act="toggle">${editing ? 'Lihat hasil' : 'Mode edit'}</button>`}
  </div></header>`;

  const editbar = editing ? `<div class="editbar"><div class="editbar-in">
    <p class="hint">Klik teks mana pun untuk mengubahnya. Ganti latar dan foto langsung di kartu profil.</p>
    <div class="swatches"><span>Tema</span>${Object.entries(THEMES).map(([k, t]) =>
      `<button class="sw" type="button" style="background:linear-gradient(135deg,${t.bg} 50%,${t.ac} 50%)" data-act="theme" data-k="${k}" aria-pressed="${s.theme === k}" aria-label="Tema ${t.name}"></button>`).join('')}</div>
    <button class="btn primary" type="button" data-act="save">Simpan index.html</button>
  </div></div>` : '';

  const banner = `<div class="banner${s.banner ? '' : ' default'}"${s.banner ? ` style="background-image:url('${s.banner}')"` : ''}>
    ${s.banner ? '' : '<span class="flare"></span>'}
    ${editing ? `<div class="banner-tools"><button class="chip-btn" type="button" data-act="banner">Ganti latar</button>${s.banner ? '<button class="chip-btn" type="button" data-act="nobanner">Reset latar</button>' : ''}</div>` : ''}
  </div>`;

  const avatar = `<div class="avatar">${s.avatar
    ? `<img src="${s.avatar}" alt="Foto ${esc(s.name)}">`
    : `<span class="ini" aria-hidden="true">${esc(initials(s.name))}</span>`}
    ${editing ? '<button class="avatar-btn" type="button" data-act="avatar">Ganti foto</button>' : ''}</div>`;

  const cta = [
    primary ? `<a class="btn primary" href="${esc(primary)}"${ext(primary)}>Hubungi saya</a>` : (editing ? '<span class="btn primary" aria-disabled="true">Hubungi saya</span>' : ''),
    hasWorks && (usable.length || editing) ? '<a class="btn ghost" href="#karya">Lihat karya</a>' : ''
  ].join('');

  const profile = `<section class="card profile">${banner}<div class="pbody">${avatar}
    ${fld('h1', '', 'name', 'Nama lengkap')}
    ${fld('p', 'headline', 'headline', 'Headline, mis. Video Editor spesialis short-form')}
    <div class="meta">${fld('span', '', 'location', 'Kota, negara')}${hasContact ? '<a href="#kontak">Info kontak</a>' : ''}</div>
    ${(s.availability || editing) ? `<p class="avail"><span class="dot"></span>${fld('span', '', 'availability', 'Status ketersediaan')}</p>` : ''}
    <div class="cta">${cta}</div></div></section>`;

  const about = hasAbout ? `<section class="card" id="tentang"><h2>Tentang</h2>
    ${fld('p', 'about', 'about', 'Ceritakan dirimu, gaya editingmu, dan jenis proyek yang kamu kerjakan.', true)}</section>` : '';

  const worksSec = hasWorks ? `<section class="card" id="karya"><h2>Karya</h2>
    ${!editing && tags.length > 2 ? `<div class="filters">${tags.map(t => `<button class="pill" type="button" data-act="filter" data-k="${esc(t)}" aria-pressed="${t === filter}">${esc(t)}</button>`).join('')}</div>` : ''}
    <div class="works">${shown.map(workCard).join('')}</div>
    ${editing ? '<button class="addbtn" type="button" data-act="addwork">Tambah karya</button>' : ''}</section>` : '';

  const exp = hasExp ? `<section class="card" id="pengalaman"><h2>Pengalaman</h2>
    <div class="jobs">${s.experience.map((j, i) => `<div class="job">
      <div class="logo" aria-hidden="true">${esc(((j.org || j.role || 'P').trim()[0] || 'P').toUpperCase())}</div>
      <div>${fld('h3', '', `experience.${i}.role`, 'Posisi')}
        ${fld('div', 'org', `experience.${i}.org`, 'Nama tempat atau klien')}
        ${fld('div', 'when', `experience.${i}.when`, 'Periode, mis. 2024 sampai sekarang')}
        ${fld('p', 'desc', `experience.${i}.desc`, 'Apa yang kamu kerjakan dan hasilnya', true)}
        ${editing ? `<button class="mini danger" type="button" data-act="delxp" data-i="${i}">Hapus pengalaman</button>` : ''}
      </div></div>`).join('')}</div>
    ${editing ? '<button class="addbtn" type="button" data-act="addxp">Tambah pengalaman</button>' : ''}</section>` : '';

  const contact = hasContactCard ? `<section class="card" id="kontak"><h2>Kontak</h2><ul class="clist">
    ${CONTACTS.map(([k, label, ph, fn]) => {
      const v = s.contact[k];
      if (!editing && !v) return '';
      const inner = editing ? `<span class="v"${ed('contact.' + k, ph)}>${esc(v)}</span>` : `<a href="${esc(fn(v))}"${ext(fn(v))}>${esc(v)}</a>`;
      return `<li><span class="k">${label}</span>${inner}</li>`;
    }).join('')}</ul></section>` : '';

  const skills = hasSkills ? `<section class="card" id="tools"><h2>Tools dan keahlian</h2>
    <div class="chips">${s.skills.map((k, i) => `<span class="chip">${esc(k)}${editing ? `<button type="button" data-act="delsk" data-i="${i}" aria-label="Hapus ${esc(k)}">×</button>` : ''}</span>`).join('')}</div>
    ${editing ? '<div class="addrow"><input class="linkin" id="newSkill" placeholder="Tambah tool atau keahlian" aria-label="Tambah keahlian"><button class="mini" type="button" data-act="addsk">Tambah</button></div>' : ''}</section>` : '';

  return `${topbar}${editbar}
    <main class="wrap" id="top"><div class="stack">${profile}${about}${worksSec}${exp}</div>
    <aside class="stack">${contact}${skills}</aside></main>
    <footer class="foot">© ${new Date().getFullYear()} ${esc(s.name)}</footer>`;
}

function render() {
  document.documentElement.dataset.theme = state.theme;
  app.innerHTML = view();
  document.title = `${state.name} | Portofolio Video Editor`;
  if (!app.classList.contains('ready')) setTimeout(() => app.classList.add('ready'), 1800);
}

/* ---------- Gambar ---------- */
function loadImage(file) {
  return new Promise((res, rej) => {
    const u = URL.createObjectURL(file); const im = new Image();
    im.onload = () => { URL.revokeObjectURL(u); res(im); };
    im.onerror = () => rej(new Error('Gambar tidak bisa dibaca'));
    im.src = u;
  });
}
async function toDataUrl(file, { max, square, q }) {
  const im = await loadImage(file);
  let sw = im.naturalWidth, sh = im.naturalHeight, sx = 0, sy = 0;
  if (square) { const m = Math.min(sw, sh); sx = (sw - m) / 2; sy = (sh - m) / 2; sw = sh = m; }
  const k = Math.min(1, max / Math.max(sw, sh));
  const c = document.createElement('canvas');
  c.width = Math.round(sw * k); c.height = Math.round(sh * k);
  c.getContext('2d').drawImage(im, sx, sy, sw, sh, 0, 0, c.width, c.height);
  return c.toDataURL('image/jpeg', q);
}
let toastTimer;
function toast(msg) {
  const t = $('#toast'); t.textContent = msg; t.classList.add('on');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('on'), 4200);
}
$('#pickBanner').addEventListener('change', async e => {
  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
  try { state.banner = await toDataUrl(f, { max: 1800, q: 0.82 }); render(); }
  catch { toast('Gambar tidak bisa dibaca. Coba file JPG atau PNG lain.'); }
});
$('#pickAvatar').addEventListener('change', async e => {
  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
  try { state.avatar = await toDataUrl(f, { max: 480, square: true, q: 0.88 }); render(); }
  catch { toast('Gambar tidak bisa dibaca. Coba file JPG atau PNG lain.'); }
});

/* ---------- Pemutar ---------- */
const dlg = $('#player'), pf = $('#pframe');
function play(i) {
  const w = state.works[i]; const id = ytId(w.url); if (!id) return;
  pf.className = 'pframe' + (w.format === 'wide' ? '' : ' short');
  pf.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1" title="${esc(w.title)}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>`;
  $('#ytlink').href = 'https://www.youtube.com/watch?v=' + id;
  dlg.showModal();
}
dlg.addEventListener('close', () => { pf.innerHTML = ''; });
dlg.addEventListener('click', e => { if (e.target === dlg || e.target.closest('.pclose')) dlg.close(); });

/* ---------- Simpan ---------- */
function save() {
  const data = JSON.parse(JSON.stringify(state)); data.published = true;
  const prevE = editing, prevF = filter; editing = false; filter = 'Semua';
  const html = view(); editing = prevE; filter = prevF;
  const root = document.documentElement.cloneNode(true);
  root.setAttribute('data-theme', state.theme);
  const a = root.querySelector('#app'); a.innerHTML = html; a.classList.remove('ready');
  root.querySelector('#data').textContent = JSON.stringify(data).replace(/</g, '\\u003c');
  root.querySelector('title').textContent = `${state.name} | Portofolio Video Editor`;
  root.querySelector('meta[name="description"]').setAttribute('content', `${state.name}. ${state.headline || ''}`.trim());
  root.querySelector('#pframe').innerHTML = '';
  root.querySelector('#toast').textContent = '';
  const blob = new Blob(['<!doctype html>\n' + root.outerHTML], { type: 'text/html' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a'); link.href = url; link.download = 'index.html';
  document.body.appendChild(link); link.click(); link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 2000);
  toast('index.html tersimpan. Upload file itu ke Vercel untuk mempublikasikannya.');
}

/* ---------- Event ---------- */
app.addEventListener('click', e => {
  const b = e.target.closest('[data-act]'); if (!b || b.dataset.act === 'url') return;
  const i = +b.dataset.i;
  switch (b.dataset.act) {
    case 'toggle': editing = !editing; render(); window.scrollTo({ top: 0 }); break;
    case 'theme': state.theme = b.dataset.k; render(); break;
    case 'banner': $('#pickBanner').click(); break;
    case 'nobanner': state.banner = null; render(); break;
    case 'avatar': $('#pickAvatar').click(); break;
    case 'play': play(i); break;
    case 'filter': filter = b.dataset.k; render(); break;
    case 'mv': {
      const j = i + (+b.dataset.d);
      if (j < 0 || j >= state.works.length) break;
      [state.works[i], state.works[j]] = [state.works[j], state.works[i]]; render(); break;
    }
    case 'fmt': state.works[i].format = state.works[i].format === 'wide' ? 'short' : 'wide'; render(); break;
    case 'del': state.works.splice(i, 1); render(); break;
    case 'addwork':
      state.works.push({ title: 'Judul karya', url: '', tag: 'Short', format: 'short' }); render();
      { const ins = app.querySelectorAll('.linkin[data-act="url"]'); const last = ins[ins.length - 1]; if (last) { last.focus(); last.scrollIntoView({ block: 'center' }); } }
      break;
    case 'delxp': state.experience.splice(i, 1); render(); break;
    case 'addxp': state.experience.push({ role: 'Posisi', org: '', when: '', desc: '' }); render(); break;
    case 'delsk': state.skills.splice(i, 1); render(); break;
    case 'addsk': addSkill(); break;
    case 'save': save(); break;
  }
});
function addSkill() {
  const inp = $('#newSkill'); const v = inp && inp.value.trim(); if (!v) return;
  state.skills.push(v); render(); const n = $('#newSkill'); if (n) n.focus();
}
app.addEventListener('change', e => {
  const t = e.target;
  if (t.dataset.act !== 'url') return;
  const w = state.works[+t.dataset.i];
  w.url = t.value.trim();
  if (ytId(w.url)) w.format = isShortUrl(w.url) ? 'short' : 'wide';
  render();
});
app.addEventListener('input', e => {
  const t = e.target.closest('[data-path]'); if (!t) return;
  const raw = t.dataset.multi ? t.innerText : t.textContent;
  if (!raw.trim()) t.innerHTML = '';
  setPath(t.dataset.path, raw.trim());
});
app.addEventListener('keydown', e => {
  if (e.target.id === 'newSkill' && e.key === 'Enter') { e.preventDefault(); addSkill(); return; }
  const t = e.target.closest && e.target.closest('[data-path]');
  if (t && e.key === 'Enter' && !t.dataset.multi) { e.preventDefault(); t.blur(); }
});
app.addEventListener('paste', e => {
  const t = e.target.closest && e.target.closest('[data-path]'); if (!t) return;
  e.preventDefault();
  const txt = (e.clipboardData || window.clipboardData).getData('text/plain');
  document.execCommand('insertText', false, t.dataset.multi ? txt : txt.replace(/\s*\n\s*/g, ' '));
});

render();
})();
</script>


